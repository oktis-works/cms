# Dependencies
node_modules/

# Build output
dist/
# âncora na raiz: sem ela, "build/" engole também fontes como packages/core/src/build/
/build/
.turbo/
# ignora o cache do Astro, mas versiona types.d.ts (env.d.ts dele referencia o
# arquivo e o tsc falha em clone novo — astro build não o regenera)
**/.astro/*
!apps/admin/.astro/types.d.ts

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
bun-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
coverage/
.nyc_output/

# Docker
docker-compose.override.yml

# Temporary files
tmp/
temp/
*.tmp

# Compiled TypeScript
*.tsbuildinfo
*.d.ts
*.d.ts.map
*.js.map

# Package manager
# bun.lock should be committed

# Estado local da ferramenta SDD (não versionar)
.sdd/
uploads/*

# Migrations embutidas no pacote CLI (geradas no build)
packages/cli/migrations/

# Temas: dist/ dentro de um tema é asset estático servido pelo web
# (dist/theme.css), não output de build — precisa ir pro repositório.
!themes/**/dist/
!themes/**/dist/**
!templates/project/themes/**/dist/
!templates/project/themes/**/dist/**

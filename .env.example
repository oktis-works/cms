# OkCMS v2 - Environment Variables

# ============================================================
# App
# ============================================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:4321

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ============================================================
# Database (PostgreSQL)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=okcms
DB_USER=okcms
DB_PASSWORD=okcms_dev
DB_SSL=false
DB_MAX_CONNECTIONS=20

# ============================================================
# Redis (Cache & Queue)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
# Authentication
# ============================================================
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Auth Cookies (HttpOnly + Secure + SameSite)
# SameSite: strict | lax | none  (none requer Secure=true)
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_ACCESS_MAXAGE=900          # 15min (segundos)
AUTH_COOKIE_REFRESH_MAXAGE=2592000     # 30d (segundos)

# CSRF Protection (double-submit cookie)
AUTH_CSRF_ENABLED=true
AUTH_CSRF_HEADER=x-csrf-token
AUTH_CSRF_COOKIE=csrf_token
# Origens confiáveis p/ cross-port na mesma máquina (admin → api)
TRUSTED_ORIGINS=127.0.0.1:3011,localhost:3011

# ============================================================
# Storage (S3/MinIO)
# ============================================================
STORAGE_PROVIDER=local
STORAGE_BUCKET=okcms-media
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# ============================================================
# Worker
# ============================================================
WORKER_CONCURRENCY=5
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_DELAY=1000

# ============================================================
# Cache
# ============================================================
CACHE_TTL=3600
CACHE_PREFIX=bl:

{
  "name": "@oktis-works/ui",
  "version": "0.3.3",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "node": "./dist/server.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && vite build && vite build --ssr src/index.ts --config vite.ssr.config.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@oktis-works/validation": "^0.3.5",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.6"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oktis-works/cms",
    "directory": "packages/ui"
  }

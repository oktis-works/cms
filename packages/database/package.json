{
  "name": "@oktis-works/database",
  "version": "0.5.5",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && cp src/schema/schema.sql dist/schema/schema.sql",
    "dev": "tsc --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "db:migrate": "node --loader ts-node/esm src/migrations/runner.ts",
    "db:rollback": "node --loader ts-node/esm src/migrations/runner.ts rollback"
  },
  "dependencies": {
    "@oktis-works/types": "^0.5.5",
    "@oktis-works/config": "^0.5.5",
    "postgres": "3.4.0"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "ts-node": "10.9.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oktis-works/cms",
    "directory": "packages/database"
  }
}

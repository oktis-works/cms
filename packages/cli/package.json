{
  "name": "@oktis-works/cms",
  "version": "0.13.24",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "okcms": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/generate-versions.mjs && node scripts/generate-theme-assets.mjs && tsc && node scripts/copy-migrations.mjs && node scripts/copy-theme-assets.mjs",
    "prepack": "node scripts/generate-versions.mjs && node scripts/generate-theme-assets.mjs && tsc && node scripts/copy-migrations.mjs && node scripts/copy-theme-assets.mjs",
    "clean": "rm -rf dist migrations tsconfig.tsbuildinfo dist/themes"
  },
  "dependencies": {
    "@oktis-works/auth": "workspace:*",
    "@oktis-works/config": "workspace:*",
    "@oktis-works/core": "workspace:*",
    "@oktis-works/database": "workspace:*",
    "@oktis-works/validation": "workspace:*",
    "@oktis-works/theme-runtime": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  },
  "files": [
    "dist",
    "migrations",
    "themes"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/oktis-works/cms",
    "directory": "packages/cli"
  }
}

{
  "name": "okcms",
  "version": "1.0.2",
  "private": true,
  "license": "GPL-2.0-or-later",
  "description": "Hybrid, modular, API-first CMS",
  "engines": {
    "node": ">=22.17.0",
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*",
    "themes/*"
  ],
  "overrides": {
    "ioredis": "5.3.0",
    "fast-xml-parser": "4.5.7"
  },
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "build": "node scripts/build-order.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --ignore-pattern 'packages/cli/src/scaffold.test.js'",
    "audit:contracts": "node scripts/check-audit-contract.mjs",
    "check:provider-matrix": "node scripts/check-provider-matrix.mjs",
    "test:postgres": "bun --cwd packages/database scripts/postgres-acceptance.mjs",
    "test:providers": "bun --cwd packages/database scripts/provider-acceptance.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "check:api-drift": "node scripts/check-api-plugin-source-drift.mjs",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version; node scripts/sync-version.mjs --write && node packages/cli/scripts/generate-versions.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "publish:all": "node scripts/prepare-publish.mjs && for pkg in packages/* apps/api apps/admin apps/web apps/worker; do [ -f \"$pkg/package.json\" ] || continue; echo \"→ publishing $pkg\"; (cd \"$pkg\" && npm publish --access public) || exit 1; done"
  },
  "dependencies": {
    "@oktis-works/admin": "workspace:*",
    "@oktis-works/auth": "workspace:*",
    "@oktis-works/api": "workspace:*",
    "@oktis-works/web": "workspace:*",
    "@oktis-works/worker": "workspace:*"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@oktis-works/api-client": "workspace:*",
    "@oktis-works/cms": "^1.0.2",
    "@types/node": "22.0.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/semver": "7.7.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "8.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.1",
    "babel-preset-solid": "1.9.16",
    "eslint": "9.0.0",
    "playwright": "1.59.1",
    "playwright-core": "1.59.1",
    "postcss": "^8.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "^1.105.1",
    "solid-js": "1.9.18",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.31.0",
    "vite": "8.3.3",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.12"
  },
  "packageManager": "bun@1.3.14"
}

{
  "name": "okcms",
  "version": "0.4.13",
  "private": true,
  "description": "Hybrid, modular, API-first CMS",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*",
    "themes/*"
  ],
  "overrides": {
    "ioredis": "5.3.0"
  },
  "scripts": {
    "dev": "bun run --filter '@oktis-works/*' dev",
    "build": "bun run --filter '@oktis-works/*' build",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish:all": "node scripts/prepare-publish.mjs && for pkg in packages/* apps/api apps/admin apps/web apps/worker; do [ -f \"$pkg/package.json\" ] || continue; echo \"→ publishing $pkg\"; (cd \"$pkg\" && npm publish --access public) || exit 1; done"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "22.0.0",
    "@types/semver": "7.7.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "8.0.0",
    "autoprefixer": "^10.6.1",
    "eslint": "9.0.0",
    "playwright": "1.59.1",
    "playwright-core": "1.59.1",
    "postcss": "^8.5.28",
    "sass": "^1.105.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.31.0",
    "vitest": "3.0.0"
  },
  "packageManager": "bun@1.3.14"
}

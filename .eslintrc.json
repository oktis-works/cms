{
  "root": true,
  "env": {
    "es2022": true,
    "node": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "project": ["./tsconfig.json", "packages/*/tsconfig.json", "apps/*/tsconfig.json"]
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended"
  ],
  "ignorePatterns": ["dist/", "node_modules/", "*.config.*", "*.mjs", "*.cjs", "*.d.ts", "**/scaffold.test.js", "packages/cli/src/scaffold.test.js", "packages/cli/src/scaffold.test.js"],
  "rules": {
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-require-imports": "off"
  },
  "overrides": [
    {
      "files": ["**/*.js"],
      "rules": {
        "@typescript-eslint/no-require-imports": "off"
      }
    },
    {
      "files": ["packages/cli/src/scaffold.test.js"],
      "rules": {
        "parser": "espree"
      }
    }
  ]
}

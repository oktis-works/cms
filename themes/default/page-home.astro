<main data-template="page-home" data-type="page" class="page-home">
  <header class="site-header">
    <nav class="nav" role="navigation" aria-label="Navegação principal">
      <a href="/" class="site-brand" aria-label="Início">
        {{site.title}}
      </a>
      <ul class="nav-menu">
        <li><a href="/sobre">{{#if menus.header.bySlug.sobre}}{{menus.header.bySlug.sobre.label}}{{else}}Sobre{{/if}}</a></li>
        <li><a href="#contato">Contato</a></li>
        <li><a href="/blog">{{#if menus.header.bySlug.blog}}{{menus.header.bySlug.blog.label}}{{else}}Blog{{/if}}</a></li>
      </ul>
    </nav>
  </header>

  <section class="hero" id="hero" aria-labelledby="hero-title">
    <div class="hero-content">
      <h1 id="hero-title">{{field "title"}}</h1>
      {{#if (field "subtitle")}}
      <p class="hero-subtitle">{{field "subtitle"}}</p>
      {{/if}}
      <a href="/blog" class="btn btn-primary" role="button">Ver Blog</a>
    </div>
  </section>

  <section class="about-preview" id="sobre" aria-labelledby="about-title">
    <div class="container">
      <h2 id="about-title">Sobre Nós</h2>
      {{#if (field "aboutPreview.html")}}
      <div class="about-content">{{{field "aboutPreview.html"}}}</div>
      {{else}}
      <p>Conteúdo da seção "Sobre" será exibido aqui quando configurado.</p>
      {{/if}}
      <a href="/sobre" class="btn btn-secondary">Ler mais →</a>
    </div>
  </section>

  <section class="latest-posts" aria-labelledby="latest-title">
    <div class="container">
      <header class="section-header">
        <h2 id="latest-title">Últimos Artigos</h2>
      </header>
      {{#if items}}
      <div class="posts-grid">
        {{#each items}}
        <article class="post-card">
          {{#if thumbnail.url}}
          <figure class="post-card__image">
            <img src="{{thumbnail.url}}" alt="{{thumbnail.alt}}" loading="lazy" />
          </figure>
          {{/if}}
          <div class="post-card__content">
            <h3 class="post-card__title"><a href="/blog/{{slug}}">{{title}}</a></h3>
            {{#if excerpt}}
            <p class="post-card__excerpt">{{excerpt}}</p>
            {{/if}}
            <a href="/blog/{{slug}}" class="btn btn-outline">Continuar lendo</a>
          </div>
        </article>
        {{/each}}
      </div>
      {{else}}
      <p class="no-posts">Nenhum artigo publicado ainda.</p>
      {{/if}}
    </div>
  </section>

  <section class="contact" id="contato" aria-labelledby="contact-title">
    <div class="container">
      <h2 id="contact-title">Entre em Contato</h2>
      <p class="contact-intro">{{settings.contactText || 'Preencha o formulário ou envie um e-mail para contato@exemplo.com'}}</p>
      <form class="contact-form" action="mailto:contato@exemplo.com" method="POST" enctype="text/plain">
        <div class="form-group">
          <label for="contact-name">Nome</label>
          <input type="text" id="contact-name" name="name" required />
        </div>
        <div class="form-group">
          <label for="contact-email">E-mail</label>
          <input type="email" id="contact-email" name="email" required />
        </div>
        <div class="form-group">
          <label for="contact-message">Mensagem</label>
          <textarea id="contact-message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Enviar</button>
      </form>
    </div>
  </section>
</main>

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <nav class="footer-nav" aria-label="Rodapé">
      {{#each menus.footer.items}}
      <a href="{{url}}">{{label}}</a>
      {{/each}}
    </nav>
    <p class="copyright">&copy; {{new Date().getFullYear()}} {{site.title}}. Todos os direitos reservados.</p>
  </div>
</footer>

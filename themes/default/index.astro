<main data-template="index" data-type="{{page.type}}" class="page">
  <header class="page-header">
    <div class="container">
      <h1>{{settings.theme.siteTitle || page.title}}</h1>
      {{#if settings.theme.siteDescription}}
      <p class="page-description">{{settings.theme.siteDescription}}</p>
      {{/if}}
    </div>
  </header>

  <div class="page-content container">
    {{#if content.html}}
    <div class="entry-content" set:html={content.html}></div>
    {{else if content.content}}
    <div class="entry-content" set:html={content.content}></div>
    {{else if content.text}}
    <p>{{content.text}}</p>
    {{/if}}

    {{#if items}}
    <section class="listing">
      {{#each items}}
      <article class="card entry entry--item">
        <h2 class="entry__title"><a href="/{{slug}}">{{title}}</a></h2>
        {{#if excerpt}}<p class="entry__excerpt">{{excerpt}}</p>{{/if}}
      </article>
      {{/each}}
    </section>
    {{/if}}
  </div>
</main>
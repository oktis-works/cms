{
  "name": "default",
  "version": "0.36.2",
  "description": "Tema padrão do OkCMS — templates hierárquicos com interpolação real de conteúdo + Static Front Page",
  "type": "theme",
  "author": "Oktis Works",
  "compatibility": {
    "okcms": "^0.36.0"
  },
  "screenshots": [
    "screenshot.png"
  ],
  "provides": {
    "layouts": [
      "page-home",
      "page-sobre",
      "page-blog",
      "post-primeiro-post",
      "post-segundo-post",
      "page",
      "single",
      "archive",
      "index",
      "404"
    ],
    "assets": [
      "dist/theme.css"
    ]
  },
  "stylesConfig": {
    "engine": "css",
    "isolation": "manual",
    "entry": "src/theme.css",
    "output": "dist/theme.css"
  },
  "settings": [
    {
      "name": "siteTitle",
      "type": "text",
      "label": "Título do site",
      "default": "OkCMS"
    },
    {
      "name": "siteDescription",
      "type": "text",
      "label": "Descrição do site",
      "default": ""
    },
    {
      "name": "contactText",
      "type": "textarea",
      "label": "Texto da seção de contato",
      "default": "Preencha o formulário ou envie um e-mail para contato@exemplo.com"
    }
  ]
}

{
  "name": "default",
  "version": "0.37.0",
  "description": "Default OkCMS theme — React SSR with island hydration",
  "type": "theme",
  "author": "Oktis Works",
  "compatibility": {
    "okcms": "^1.0.0"
  },
  "screenshots": [
    "screenshot.png"
  ],
  "render": {
    "engine": "react",
    "apiVersion": 2,
    "hydration": "islands",
    "entry": "src/entry-server.tsx"
  },
  "stylesConfig": {
    "engine": "css",
    "isolation": true,
    "entry": "src/theme.css",
    "output": "dist/theme.css"
  },
  "provides": {
    "layouts": [
      "home",
      "index",
      "single",
      "page",
      "archive",
      "404"
    ],
    "assets": [
      "dist/theme.css"
    ]
  },
  "settings": [
    {
      "name": "contactText",
      "type": "textarea",
      "label": "Contact section text",
      "default": "Fill out the form or send us an email at hello@example.com"
    }
  ]
}

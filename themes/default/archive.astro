<main data-template="archive" data-type="{{page.type}}" class="archive">
  <header class="archive-header">
    <div class="container">
      <h1 class="archive-title">{{page.title}}</h1>
      {{#if settings.theme.siteDescription}}
      <p class="archive-description">{{settings.theme.siteDescription}}</p>
      {{/if}}
    </div>
  </header>

  <section class="posts-section" aria-labelledby="posts-title">
    <div class="container">
      {{#if items}}
      <div class="posts-grid">
        {{#each items}}
        <article class="post-card">
          {{#if thumbnail.url}}
          <figure class="post-card__image">
            <a href="/{{page.type}}/{{slug}}">
              <img src="{{thumbnail.url}}" alt="{{thumbnail.alt}}" loading="lazy" />
            </a>
          </figure>
          {{/if}}
          <div class="post-card__content">
            <header class="post-card__header">
              <time class="post-card__date" datetime="{{published_at}}">
                {{#if published_at}}
                {{formatDate published_at}}
                {{/if}}
              </time>
            </header>
            <h2 class="post-card__title"><a href="/{{page.type}}/{{slug}}">{{title}}</a></h2>
            {{#if excerpt}}
            <p class="post-card__excerpt">{{excerpt}}</p>
            {{/if}}
            <a href="/{{page.type}}/{{slug}}" class="btn btn-outline">Continue reading</a>
          </div>
        </article>
        {{/each}}
      </div>

      {{#if pagination}}
      <nav class="pagination" aria-label="Pagination">
        {{pagination}}
      </nav>
      {{/if}}
      {{else}}
      <p class="no-posts">No content published yet.</p>
      {{/if}}
    </div>
  </section>
</main>
# syntax=docker/dockerfile:1
# @oktis-works - Single OkCMS image (entrypoints: api | admin | web | worker)
#
# Generated by the CLI scaffold. Canonical at
# infrastructure/docker/Dockerfile in this monorepo.
#
# SECURITY: the command-line tool never enters this image. The container
# exposes only the application processes — no package installer, no Docker
# socket access, no way to change its own state. Deploy and configuration
# always run on the host.
FROM oven/bun:1-alpine AS base
WORKDIR /app
ENV NODE_ENV=production
ENV UPLOAD_DIR=/app/.data/storage

# --- dependencies -----------------------------------------------------------
# Manifest + lock first: changing just the code does not invalidate
# this `install`.
FROM base AS deps
COPY package.json bun.lock* package-lock.json* yarn.lock* pnpm-lock.yaml* ./
RUN bun install --production --frozen-lockfile

# --- runtime ----------------------------------------------------------------
FROM base AS runtime
# 1. project code (.dockerignore drops .env, node_modules and .data)
COPY . .
# 2. clean node_modules from the deps stage, on top — never the host's
COPY --from=deps /app/node_modules ./node_modules

RUN mkdir -p /app/.data/storage /app/.data/cache /app/logs

EXPOSE 3000 3001 3011

# `docker compose ... command: api` picks the role; see docker/entrypoint.sh
ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["api"]

# OkCMS
# Database connection — pick ONE format:
# (a) separate variables (default, used below):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=okcms
DB_USER=postgres
DB_PASSWORD=
# (b) single URL — takes precedence over the DB_* above:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/okcms

# Redis (cache + worker queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.data/storage

# Ports
PORT=3000
ADMIN_PORT=3011
WEB_PORT=3001

# Admin ↔ API communication (required for browser fetch)
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3011,http://127.0.0.1:3011
TRUSTED_ORIGINS=http://localhost:3011,http://127.0.0.1:3011

# Auth cookies (development over HTTP)
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false

# JWT
JWT_SECRET=change-me

# Active theme
ACTIVE_THEME=default

# @oktis-works - build context of the okcms/app image
# .env NEVER enters the image: it carries the database password and
# JWT_SECRET, and the image is distributed/copied. At runtime it comes
# from the host via env_file.

.env
.env.*
!.env.example

# host dependencies (the image installs its own)
node_modules
**/node_modules
.tsbuildinfo
**/*.tsbuildinfo
# NB: do NOT ignore dist/ — plugins installed in plugins/*/dist are runtime.

# local data and state
.data
**/.data
logs
**/logs
*.log
coverage
**/coverage

# mounted at runtime, not copied
deploy/

# VCS and tooling — not runtime code
.git
.github
.gitignore
.sdd
.vscode
.idea
.claude
*.md
!README.md

# Source code & tests (not needed in runtime image)
*.ts
*.tsx
*.test.*
*.spec.*
test/
tests/
spec/
__tests__/
__mocks__/

# Docs & tooling
scripts/
docs/

# Maps & build artifacts
*.map
tsconfig*.json
.turbo/
.cache/

# infrastructure mounted at runtime, not copied inside
docker-compose*.yml
deploy/nginx/certs

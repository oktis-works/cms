exports[`template theme golden HTML (legacy string-template renderer) > 404 1`] = `
"<!DOCTYPE html>
<html lang="en" data-theme="legacy-template">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content="OkCMS 0.42.7">
  <title>Golden Site</title>
  <meta name="description" content="Golden description">
    <meta name="robots" content="index,follow">

  <meta property="og:title" content="Golden Site">
  <meta property="og:description" content="Golden description">
  <meta property="og:image" content="https://example.com/logo.png">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Golden Site">
  <meta property="og:locale" content="en">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Golden Site">
  <meta name="twitter:description" content="Golden description">
  <meta name="twitter:image" content="https://example.com/logo.png">
  <link rel="stylesheet" href="/themes/legacy-template/dist/theme.css" data-theme-style="legacy-template" />
</head>  <body>
<main data-theme="legacy-template" class="error-404">
  <h1>404</h1>
  <h2>Page Not Found</h2>
  <p>Sorry, we couldn't find the page you're looking for.</p>
  <a href="/" class="btn btn-primary">Go Home</a>
</main>
</body>
</html>"
`;


  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content="OkCMS 0.42.7">
  <title>Golden Article | Golden Site</title>
  <meta name="description" content="Golden excerpt">
    <meta name="robots" content="index,follow">

  <meta property="og:title" content="Golden Article">
  <meta property="og:description" content="Golden excerpt">
  <meta property="og:image" content="https://example.com/logo.png">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Golden Site">
  <meta property="og:locale" content="en">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Golden Article">
  <meta name="twitter:description" content="Golden excerpt">
  <meta name="twitter:image" content="https://example.com/logo.png">
  <link rel="stylesheet" href="/themes/legacy-template/dist/theme.css" data-theme-style="legacy-template" />
</head>  <body>
<div data-theme="legacy-template"><header class="site-header">
  <div class="container">
    <h1>Golden Site</h1>
    <p>Golden description</p>
  </div>
</header>

<section class="hero">
  <div class="hero-content">
    <h1>Welcome to Golden Site</h1>
    <p class="hero-subtitle"></p>
    <a href="/blog" class="btn btn-primary">Read the Blog</a>
  </div>
</section>

<section class="about-preview">
  <div class="container">
    <div class="about-content">
      <h2>About This Site</h2>
      <p>This is the default OkCMS theme using the legacy template engine.</p>
      <a href="/about" class="btn btn-secondary">Learn More</a>
    </div>
  </div>
</section>

<section class="posts">
  <div class="container">
    <header class="section-header">
      <h2>Latest Posts</h2>
    </header>
    <div class="posts-grid">
      
        <article class="post-card">
          <div class="post-card__content">
            <div class="post-card__header">
              <time class="post-card__date"></time>
            </div>
            <h2 class="post-card__title">
              <a href="/first">First</a>
            </h2>
            
            <a href="/first" class="btn btn-outline">Read More</a>
          </div>
        </article>
      
    </div>
  </div>
</section></div>
</body>
</html>"
`;


---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { PostTypesManager } from '../../components/apps/settings/PostTypesManager';
import { PageHeader } from '../../components/shared/PageHeader';

const { t } = Astro.locals;
---

<DashboardLayout title={t('settings.postTypes.title')}>
  <PageHeader
    title={t('settings.postTypes.title')}
    description={t('settings.postTypes.description')}
  />
  <PostTypesManager client:load />
</DashboardLayout>

<style>
  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .supports {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }
</style>
---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { PostTypesManager } from '../../components/apps/settings/PostTypesManager';

const { t } = Astro.locals;
---

<DashboardLayout title={t('settings.postTypes.title')}>
  <div class="settings-page">
    <div class="page-header">
      <h2>{t('settings.postTypes.title')}</h2>
      <p>{t('settings.postTypes.description')}</p>
    </div>
    <PostTypesManager client:load />
  </div>
</DashboardLayout>

<style>
  .settings-page .page-header {
    margin-bottom: 1rem;
  }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .supports {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }
</style>
---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { PostTypesManager } from '../../components/apps/settings/PostTypesManager';
---

<DashboardLayout title="Post Types">
  <div class="settings-page">
    <div class="page-header">
      <h2>Content Types</h2>
      <p>Crie tipos de conteúdo personalizados (CPTs) além de Posts e Páginas.</p>
    </div>
    <PostTypesManager client:load />
  </div>
</DashboardLayout>

<style>
  .settings-page .page-header {
    margin-bottom: 1rem;
  }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .supports {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }
</style>

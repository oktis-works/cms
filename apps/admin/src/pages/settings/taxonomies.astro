---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { TaxonomiesManager } from '../../components/apps/settings/TaxonomiesManager';
import { PageHeader } from '../../components/shared/PageHeader';

const { t } = Astro.locals;
---

<DashboardLayout title={t('settings.taxonomies.title')}>
  <PageHeader
    title={t('settings.taxonomies.title')}
    description={t('settings.taxonomies.description')}
  />
  <TaxonomiesManager client:load />
</DashboardLayout>

<style>
  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }
</style>
---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const { t } = Astro.locals;
---

<DashboardLayout title={t('settings.general.title')}>
  <div class="settings-page">
    <div class="page-header">
      <h2>{t('settings.general.title')}</h2>
      <p>{t('settings.general.description')}</p>
    </div>

    <div class="settings-cards">
      <a class="card settings-card" href="/settings/general">
        <h3>{t('settings.general.title')}</h3>
        <p class="muted">{t('settings.general.fields.siteTitle')}, {t('settings.general.fields.siteDescription')}, {t('settings.general.fields.language')} e {t('settings.general.fields.timezone')} do site.</p>
      </a>
      <a class="card settings-card" href="/settings/post-types">
        <h3>{t('settings.postTypes.title')}</h3>
        <p class="muted">{t('settings.postTypes.description')}</p>
      </a>
      <a class="card settings-card" href="/settings/taxonomies">
        <h3>{t('settings.taxonomies.title')}</h3>
        <p class="muted">{t('settings.taxonomies.description')}</p>
      </a>
    </div>
  </div>
</DashboardLayout>

<style>
  .settings-page .page-header {
    margin-bottom: 1rem;
  }
  .settings-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
  .settings-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .settings-card:hover {
    border-color: var(--color-primary);
  }
</style>
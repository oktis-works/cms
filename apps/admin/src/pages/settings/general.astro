---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { GeneralSettings } from '../../components/apps/settings/GeneralSettings';

const { t } = Astro.locals;
---

<DashboardLayout title={t('settings.general.title')}>
  <div class="settings-page">
    <div class="page-header">
      <h2>{t('settings.general.title')}</h2>
      <p>{t('settings.general.description')}</p>
      <p><a href="/settings">{t('settings.general.back')}</a></p>
    </div>
    <GeneralSettings client:load />
  </div>
</DashboardLayout>

<style>
  .settings-page .page-header {
    margin-bottom: 1rem;
  }
</style>
---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { AccessManager } from '../../components/apps/settings/ResourceHubs';
const { t } = Astro.locals;
---
<DashboardLayout title={t('access.title')}>
  <div class="settings-page"><div class="page-header"><h2>{t('access.title')}</h2><p>{t('access.description')}</p></div><AccessManager client:load /></div>
</DashboardLayout>
<style>.settings-page .page-header { margin-bottom: 1rem; }</style>

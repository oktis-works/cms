---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { PageHeader } from '../../components/shared/PageHeader';

// D1 — página de plugin renderizada declarativamente: o shell fornece o
// contêiner isolado [data-plugin] e o runtime de componentes do plugin
// monta a UI a partir do componentId declarado no manifest.
const { slug } = Astro.props;
const pluginSlug = String(slug ?? '').split('/')[0] ?? '';
const pageTitle = String(slug ?? 'Plugin');
---

<DashboardLayout title={pageTitle}>
  <PageHeader
    title={pageTitle}
    description={`Página de extensão do plugin ${pluginSlug}`}
  />
  <div class="plugin-page" data-plugin={pluginSlug} data-plugin-page={slug}>
    <div class="card plugin-page__container">
      <div class="plugin-page__mount" data-plugin-component={`page:${slug}`} data-plugin={pluginSlug}>
        <!-- Componente do plugin (declarativo, sem injeção de DOM direta — DECI-027) -->
      </div>
    </div>
  </div>
</DashboardLayout>

<style>
  .plugin-page__mount {
    margin-top: 1rem;
    min-height: 8rem;
  }
</style>

---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { ContentEditor } from '../../components/content/ContentEditor';

const { t } = Astro.locals;
const initialType = Astro.url.searchParams.get('type') ?? undefined;
---

<DashboardLayout title={t('content.editor.save')}>
  <div class="editor-page">
    <ContentEditor client:load initialType={initialType} />
  </div>
</DashboardLayout>

<style>
  .editor-page {
    max-width: 1200px;
  }
</style>

---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { TaxonomyTermsManager } from '../../../components/content/TaxonomyTermsManager';

const { t } = Astro.locals;
const contentType = Astro.params.type ?? '';
const taxonomySlug = Astro.url.searchParams.get('taxonomy') ?? '';
---

<DashboardLayout title={t('content.taxonomy.title')}>
  <div class="taxonomy-page">
    <div class="page-header">
      <a href={`/content/${encodeURIComponent(contentType)}`} class="back-link">{t('content.taxonomy.back')}</a>
      <h2>{t('content.taxonomy.title')}</h2>
      <p>{taxonomySlug || t('content.taxonomy.choose')}</p>
    </div>
    <TaxonomyTermsManager client:load taxonomySlug={taxonomySlug} contentType={contentType} />
  </div>
</DashboardLayout>

<style>
  .taxonomy-page { max-width: 960px; }
</style>

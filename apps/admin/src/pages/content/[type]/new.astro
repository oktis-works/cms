---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { ContentEditor } from '../../../components/content/ContentEditor';
import { PageHeader } from '../../../components/shared/PageHeader';

const { t } = Astro.locals;
const contentType = Astro.params.type ?? 'post';
---

<DashboardLayout title={t('content.editor.new')}>
  <PageHeader
    title={t('content.editor.new')}
    eyebrow={contentType}
  />
  <ContentEditor client:load initialType={contentType} />
</DashboardLayout>

---
import BaseLayout from './BaseLayout.astro';
import { PluginExtensionsSlot, PluginDashboardWidgetsSlot } from '../ext/extensions';
import { AdminBar } from '../components/admin-bar/AdminBar';
import { AtGlanceWidget } from '../components/dashboard-widgets/AtGlanceWidget';
import { QuickDraftWidget } from '../components/dashboard-widgets/QuickDraftWidget';
import { ActivityWidget } from '../components/dashboard-widgets/ActivityWidget';
import { Footer } from '../components/Footer';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const { t } = Astro.locals;

// Session resolved in SSR by middleware: AdminBar receives user ready
// and session guard doesn't need /auth/me on the client.
const sessionUser = (Astro.locals as { user?: { id: string; email: string; name: string; avatar?: string | null } | null }).user ?? null;
const sessionState = (Astro.locals as { sessionState?: 'anonymous' | 'authenticated' | 'unavailable' }).sessionState ?? 'unavailable';

const pathname = Astro.url.pathname;
const isActive = (href: string): boolean =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);

const navActive = {
  dashboard: isActive('/'),
  media: isActive('/media'),
  users: isActive('/users'),
  menus: isActive('/menus'),
  settings: isActive('/settings'),
  plugins: isActive('/plugins'),
  themes: isActive('/themes'),
  customize: isActive('/customize'),
  comments: isActive('/comments'),
};

const settingsChildren = [
  { href: '/settings/general', key: 'settings.general.title', active: isActive('/settings/general') },
  { href: '/settings/reading', key: 'settings.reading.title', active: isActive('/settings/reading') },
  { href: '/settings/post-types', key: 'settings.postTypes.title', active: isActive('/settings/post-types') },
  { href: '/settings/custom-fields', key: 'settings.customFields.title', active: isActive('/settings/custom-fields') },
  { href: '/settings/taxonomies', key: 'settings.taxonomies.title', active: isActive('/settings/taxonomies') },
  { href: '/settings/access', key: 'access.title', active: isActive('/settings/access') },
  { href: '/settings/logs', key: 'logs.title', active: isActive('/settings/logs') },
  { href: '/settings/webhooks', key: 'webhooks.title', active: isActive('/settings/webhooks') },
  { href: '/settings/api-keys', key: 'apiKeys.title', active: isActive('/settings/api-keys') },
];

---

<BaseLayout title={title} description={description}>
  <!-- Top Admin Bar — recebe a sessão resolvida no SSR (sem /auth/me extra) -->
  <AdminBar client:load user={sessionUser ?? undefined} />

  <div class="layout" data-session-state={sessionState}>
    <div class="dashboard-body">
    <!-- Sidebar colapsavel — o estado (body.sidebar-collapsed) e aplicado pelo script abaixo -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <span class="sidebar-collapsed-brand" title={t('layout.appName')}>
          <img src="/logo.svg" width="28" height="28" alt="" />
        </span>
      </div>

      <nav class="sidebar-nav">
        <a href="/" class:list={['nav-item', { active: navActive.dashboard }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          <span class="nav-label" data-sidebar-i18n="layout.nav.dashboard">{t('layout.nav.dashboard')}</span>
        </a>

        <a href="/media" class:list={['nav-item', { active: navActive.media }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <span class="nav-label" data-sidebar-i18n="layout.nav.media">{t('layout.nav.media')}</span>
        </a>

        <a href="/users" class:list={['nav-item', { active: navActive.users }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          <span class="nav-label" data-sidebar-i18n="layout.nav.users">{t('layout.nav.users')}</span>
        </a>

        <a href="/menus" class:list={['nav-item', { active: navActive.menus }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
          <span class="nav-label" data-sidebar-i18n="layout.nav.menus">{t('layout.nav.menus')}</span>
        </a>

        <div class:list={['nav-group', { open: navActive.settings }]} data-nav-group="settings">
          <div class="nav-group-header">
        <a href="/settings/general" class:list={['nav-item', { active: navActive.settings }]}>
          <svg class="settings-nav-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 0-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06-.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1.82-.33l-.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0-2.83l-.06-.06a1.65 1.65 0 0 0-.33-1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          <span class="nav-label" data-sidebar-i18n="layout.nav.settings">{t('layout.nav.settings')}</span>
        </a>

          </div>

        <!-- Submenu de configurações fica agrupado diretamente sob Settings. -->
        <div class="nav-submenu">
          {settingsChildren.map((child) => (
            <a href={child.href} class:list={['nav-subitem', { active: child.active }]} data-sidebar-i18n={child.key}>
              {t(child.key)}
            </a>
          ))}
        </div>
        </div>

        <a href="/plugins" class:list={['nav-item', { active: navActive.plugins }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="2" ry="2"></rect>
            <path d="M15 7h4a2 2 0 0 1 2 2v4"></path>
            <path d="M9 17H5a2 2 0 0 1-2-2V9"></path>
            <line x1="8" y1="12" x2="16" y2="12"></line>
          </svg>
          <span class="nav-label" data-sidebar-i18n="layout.nav.plugins">{t('layout.nav.plugins')}</span>
        </a>

        <div class:list={['nav-group', { open: navActive.themes || navActive.customize }]} data-nav-group="themes">
          <a href="/themes" class:list={['nav-item', { active: navActive.themes }]} data-sidebar-i18n="layout.nav.themes">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              <path d="M2 12h20"></path>
            </svg>
            <span class="nav-label">{t('layout.nav.themes')}</span>
          </a>

          <div class="nav-submenu" data-nav-submenu="themes">
            <a href="/themes" class:list={['nav-subitem', { active: navActive.themes }]} data-sidebar-i18n="layout.nav.themes">
              {t('layout.nav.themes')}
            </a>
            <a href="/customize" class:list={['nav-subitem', { active: navActive.customize }]} data-sidebar-i18n="layout.nav.customize">
              {t('layout.nav.customize')}
            </a>
            <a href="/settings/reading" class:list={['nav-subitem', { active: navActive.settings && navActive.settings === 'reading' }]} data-sidebar-i18n="layout.nav.settings_reading">
              {t('layout.nav.settings_reading')}
            </a>
          </div>
        </div>
        
        <a href="/comments" class:list={['nav-item', { active: navActive.comments }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <span class="nav-label" data-sidebar-i18n="layout.nav.comments">{t('layout.nav.comments')}</span>
        </a>

        <!-- D1: slots de extensao — paginas de menu declaradas por plugins ativos -->
        <PluginExtensionsSlot client:load />
      </nav>
    </aside>

    <main class="main-content">
      <div class="content-wrapper">
        <div class="content">
          <slot />

          <!-- Dashboard Widgets (only on dashboard page) -->
          {pathname === '/' && (
            <div class="dashboard-widgets-area">
              <div class="dashboard-widgets-grid">
                <AtGlanceWidget client:load />
                <QuickDraftWidget client:load />
                <ActivityWidget client:load />
                <PluginDashboardWidgetsSlot client:load />
              </div>
            </div>
          )}
        </div>

      </div>
    </main>
    </div>

    <!-- Footer global: faixa independente com a largura total da viewport. -->
    <Footer client:load />
  </div>
</BaseLayout>

<script>
  import { apiClient, ApiError, RATE_LIMITED_EVENT } from '../lib/api';
  import { createIcons, icons } from 'lucide';

  // Session guard — middleware already resolved /auth/me in SSR, so:
  //
  //  • authenticated → nothing to check on client (before: 1 /auth/me per page);
  //  • anonymous     → no access_token, redirect WITHOUT calling API (before:
  //                     was an /auth/me just to get 401);
  //  • unavailable   → token present but API didn't respond in SSR: client
  //                     checks, and ONLY a definitive 401 leads to login. 429/5xx
  //                     /network do NOT log out — treating everything as "no session"
  //                     was what threw users to login with session still valid.
  void (async () => {
    const state = document.querySelector<HTMLElement>('.layout')?.dataset.sessionState ?? 'unavailable';
    if (state === 'authenticated') return;
    if (state === 'anonymous') {
      window.location.replace('/login');
      return;
    }
    const session = await apiClient.checkSession();
    if (session === 'unauthenticated') window.location.replace('/login');
  })();

  // Proactive access token refresh (before 401): without this, returning to tab
  // after 15min idle fired ~20 requests with simultaneous 401s.
  apiClient.installProactiveRefresh();
  void apiClient.ensureFreshSession();

  // Non-blocking rate limit notice: UI explains instead of failing silently.
  let rateLimitNotice: HTMLElement | null = null;
  let noticeT: ((key: string, params?: Record<string, string | number>) => string) | null = null;
  const showRateLimitNotice = (retryAfter: number | null): void => {
    if (!rateLimitNotice) {
      rateLimitNotice = document.createElement('div');
      rateLimitNotice.className = 'okcms-rate-limit-notice';
      rateLimitNotice.setAttribute('role', 'status');
      rateLimitNotice.setAttribute('aria-live', 'polite');
      document.body.append(rateLimitNotice);
    }
    if (noticeT) {
      rateLimitNotice.textContent = retryAfter
        ? noticeT('rateLimit.noticeRetry', { seconds: retryAfter })
        : noticeT('rateLimit.notice');
    }
    rateLimitNotice.classList.add('visible');
    setTimeout(() => rateLimitNotice?.classList.remove('visible'), Math.min(10_000, (retryAfter ?? 5) * 1000 + 4000));
  };
  window.addEventListener(RATE_LIMITED_EVENT, (event) => {
    showRateLimitNotice((event as CustomEvent<{ retryAfter?: number | null }>).detail?.retryAfter ?? null);
  });
  // Texto traduzido carregado fora do caminho quente do evento.
  void (async () => {
    try {
      const locale = ((document.documentElement.lang || 'en') as Locale);
      const t = await getTFunction(locale);
      noticeT = t;
    } catch {
      // no translation: notice stays with API text in console
    }
  })();

  // Estado salvo da sidebar colapsada (o botao de toggle fica no AdminBar e
  // alterna body.sidebar-collapsed + persiste em localStorage)
  try {
    if (localStorage.getItem('sidebar-collapsed') === 'true') {
      document.body.classList.add('sidebar-collapsed');
    }
  } catch {
    // storage unavailable - sidebar starts expanded
  }

  import { getTFunction, type Locale } from '../i18n';

  const setupNavGroups = (): void => {
    document.querySelectorAll<HTMLElement>('[data-nav-group]').forEach((group) => {
      const toggle = group.querySelector<HTMLButtonElement>(':scope > .nav-group-header .nav-group-toggle');
      if (!toggle || toggle.dataset.bound === 'true') return;
      toggle.dataset.bound = 'true';
      toggle.addEventListener('click', () => {
        const open = !group.classList.contains('open');
        group.classList.toggle('open', open);
        toggle.setAttribute('aria-expanded', String(open));
      });
    });
  };

  const createSidebarLink = (label: string, href: string, className = 'nav-item', translationKey?: string): HTMLAnchorElement => {
    const link = document.createElement('a');
    link.className = className;
    link.href = href;
    link.textContent = label;
    if (translationKey) link.dataset.sidebarI18n = translationKey;
    return link;
  };

  const renderContentTypes = async (): Promise<void> => {
    const target = document.querySelector<HTMLElement>('[data-post-types-menu]');
    if (!target) return;

    try {
      const [types, taxonomies] = await Promise.all([
        apiClient.getContentTypes(),
        apiClient.getTaxonomies().catch(() => []),
      ]);
      target.replaceChildren();
      const currentParams = new URLSearchParams(window.location.search);

      for (const type of types) {
        const entry = document.createElement('div');
        entry.className = 'nav-type-entry';

        const row = document.createElement('div');
        row.className = 'nav-type-row';
        const typeLink = createSidebarLink(
          type.pluralLabel || type.name,
          `/content/${encodeURIComponent(type.slug)}`,
          'nav-item nav-type-link'
        );
        typeLink.classList.toggle('active', window.location.pathname.startsWith(`/content/${type.slug}`));
        const typeIcon = document.createElement('i');
        typeIcon.dataset.lucide = type.menuIcon || 'box';
        typeIcon.className = 'nav-type-icon';
        typeIcon.setAttribute('aria-hidden', 'true');
        typeLink.prepend(typeIcon);
        row.append(typeLink);

        const attached = taxonomies.filter((taxonomy) => taxonomy.attachTo?.includes(type.slug));
        entry.append(row);

        if (attached.length > 0) {
          const taxonomyMenu = document.createElement('div');
          taxonomyMenu.className = 'nav-taxonomy-menu';
          const shouldOpen = currentParams.get('type') === type.slug || window.location.pathname.startsWith(`/content/${type.slug}`);

          // No separate button and no caret: the link navigates to the content type AND
          // opens the taxonomy dropdown at the same time (navigation is MPA,
          // so the state reopens correctly in SSR).
          typeLink.classList.add('has-taxonomies');

          const setMenuOpen = (open: boolean): void => {
            taxonomyMenu.classList.toggle('open', open);
            typeLink.classList.toggle('is-expanded', open);
          };
          setMenuOpen(shouldOpen);
          typeLink.addEventListener('click', () => setMenuOpen(true));

          for (const taxonomy of attached) {
            const label = taxonomy.labels?.['plural_name'] ?? taxonomy.labels?.['name'] ?? taxonomy.name;
            const taxonomyLink = createSidebarLink(
              label,
              `/content/${encodeURIComponent(type.slug)}/taxonomy?taxonomy=${encodeURIComponent(taxonomy.slug)}`,
              'nav-subitem nav-taxonomy-item'
            );
            const taxonomyUrl = new URL(taxonomyLink.href, window.location.origin);
            taxonomyLink.classList.toggle(
              'active',
              window.location.pathname === taxonomyUrl.pathname && currentParams.get('taxonomy') === taxonomy.slug
            );
            taxonomyMenu.append(taxonomyLink);
          }
          entry.append(taxonomyMenu);
        }

        target.append(entry);
      }
      createIcons({ icons });
    } catch {
      // The rest of the sidebar remains usable while the API is booting.
    }
  };

  setupNavGroups();

  // Link "Settings" navega E abre o dropdown do grupo ao mesmo tempo —
  // no separate caret (same pattern as content types with taxonomies).
  {
    const settingsGroup = document.querySelector<HTMLElement>('[data-nav-group="settings"]');
    const settingsLink = settingsGroup?.querySelector<HTMLAnchorElement>(':scope > a.nav-item');
    settingsLink?.addEventListener('click', () => settingsGroup?.classList.add('open'));
  }

  // Link "Themes" navega E abre o dropdown do grupo ao mesmo tempo
  {
    const themesGroup = document.querySelector<HTMLElement>('[data-nav-group="themes"]');
    const themesLink = themesGroup?.querySelector<HTMLAnchorElement>(':scope > a.nav-item');
    themesLink?.addEventListener('click', () => themesGroup?.classList.add('open'));
  }

  createIcons({ icons });
  void renderContentTypes();
  window.addEventListener('okcms:content-models-changed', () => void renderContentTypes());

  const updateSidebarTranslations = async (locale: Locale): Promise<void> => {
    const translate = await getTFunction(locale);
    document.querySelectorAll<HTMLElement>('[data-sidebar-i18n]').forEach((element) => {
      const key = element.dataset.sidebarI18n;
      if (key) element.textContent = translate(key);
    });
  };

  window.addEventListener('okcms:locale-changed', (event) => {
    const locale = (event as CustomEvent<{ locale?: Locale }>).detail?.locale;
    if (locale) void updateSidebarTranslations(locale);
  });

</script>

<style is:global>
  /* is:global: os links dinâmicos de content-types (criados por JS) não
      recebem data-astro-cid — precisam casar com estas regras.
     O documento é travado na viewport e .layout ocupa exatamente 100vh — sem
     o antigo padding-top no <html> nem calc(100vh - 46px) no layout. O offset
     da AdminBar fixa (46px) é aplicado DENTRO do layout: margin-top no
     .content-wrapper (corpo de cada página) e padding-top na .sidebar.
     Scoped to DashboardLayout so the login page (BaseLayout)
     keeps its normal scrolling behavior. */
  :global(html), :global(body) {
    height: 100%;
    min-height: 0;
    overflow: hidden;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Layout ocupa a viewport inteira; a faixa da AdminBar é sobreposta no topo
     e compensada dentro de .sidebar e .content-wrapper. */
  .layout {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100vh;
    min-height: 0;
    margin: 0;
    box-sizing: border-box;
    overflow: hidden;
  }

  .dashboard-body {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    align-items: stretch;
  }

  .sidebar { grid-column: 1; grid-row: 1; }
  .main-content { grid-column: 2; grid-row: 1; min-width: 0; min-height: 0; overflow-y: auto; background: transparent; }
  .admin-footer {
    flex: 0 0 auto;
    width: 100%;
    min-width: 100%;
  }

  /* Collapsed sidebar state */
  body.sidebar-collapsed .dashboard-body {
    grid-template-columns: 72px minmax(0, 1fr);
  }

  /* Keep the footer below the whole dashboard body, never over the sidebar. */
  .dashboard-body > .sidebar,
  .dashboard-body > .main-content {
    min-height: 0;
  }

  body.sidebar-collapsed .sidebar-nav .nav-item span,
  body.sidebar-collapsed .nav-submenu,
  body.sidebar-collapsed .nav-group-toggle,
  body.sidebar-collapsed .nav-type-caret {
    display: none;
  }

  body.sidebar-collapsed .sidebar {
    width: 72px;
    padding: calc(var(--admin-bar-h, 46px) + 1rem) 0.5rem 1rem;
  }

  body.sidebar-collapsed .nav-item {
    justify-content: center;
    padding: 0.5rem;
  }

  body.sidebar-collapsed .sidebar-toggle {
    margin: 0 auto;
  }

  body.sidebar-collapsed .sidebar-collapsed-brand {
    display: block !important;
    text-align: center;
    padding: 0.5rem;
  }

  body.sidebar-collapsed .main-content {
    margin-left: 0;
  }

  /* Collapsed brand in sidebar header */
  .sidebar-collapsed-brand {
    display: none;
    text-align: center;
    padding: 0.5rem;
  }

  /* Sidebar */
  .sidebar {
    background: var(--color-surface-dark);
    border-right: 1px solid var(--color-border);
    /* topo reserva a faixa da AdminBar fixa (o layout agora começa em y=0) */
    padding: calc(var(--admin-bar-h, 46px) + 1.5rem) 1rem 1.5rem;
    height: 100%;
    min-height: 0;
    position: relative;
    top: auto;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-gutter: stable;

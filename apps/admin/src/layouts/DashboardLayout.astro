---
import BaseLayout from './BaseLayout.astro';
import { PluginExtensionsSlot } from '../ext/extensions';
import { AdminBar } from '../components/admin-bar/AdminBar';
import { AtGlanceWidget } from '../components/dashboard-widgets/AtGlanceWidget';
import { QuickDraftWidget } from '../components/dashboard-widgets/QuickDraftWidget';
import { ActivityWidget } from '../components/dashboard-widgets/ActivityWidget';
import { Footer } from '../components/Footer';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const { t } = Astro.locals;

const pathname = Astro.url.pathname;
const isActive = (href: string): boolean =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);

const navActive = {
  dashboard: isActive('/'),
  content: isActive('/content'),
  media: isActive('/media'),
  users: isActive('/users'),
  settings: isActive('/settings'),
  plugins: isActive('/plugins'),
  themes: isActive('/themes'),
};

const settingsChildren = [
  { href: '/settings/general', label: t('settings.general.title'), active: isActive('/settings/general') },
  { href: '/settings/post-types', label: t('settings.postTypes.title'), active: isActive('/settings/post-types') },
  { href: '/settings/custom-fields', label: t('settings.customFields.title'), active: isActive('/settings/custom-fields') },
  { href: '/settings/taxonomies', label: t('settings.taxonomies.title'), active: isActive('/settings/taxonomies') },
  { href: '/settings/resources', label: t('resources.title'), active: isActive('/settings/resources') },
  { href: '/settings/access', label: t('access.title'), active: isActive('/settings/access') },
  { href: '/settings/operations', label: t('operations.title'), active: isActive('/settings/operations') },
];

---

<BaseLayout title={title} description={description}>
  <!-- Top Admin Bar — busca a sessao real (/auth/me) no mount -->
  <AdminBar client:load />

  <div class="layout">
    <!-- Sidebar colapsavel — o estado (body.sidebar-collapsed) e aplicado pelo script abaixo -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <span class="sidebar-collapsed-brand" title={t('layout.appName')}>
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="28" height="28">
            <rect width="32" height="32" rx="8" fill="url(#grad)"/>
            <path d="M8 10h16M8 16h12M8 22h8" stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <defs>
              <linearGradient id="grad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#D8B45E"/>
                <stop offset="100%" stop-color="#B99542"/>
              </linearGradient>
            </defs>
          </svg>
        </span>
      </div>

      <nav class="sidebar-nav">
        <a href="/" class:list={['nav-item', { active: navActive.dashboard }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          <span class="nav-label">{t('layout.nav.dashboard')}</span>
        </a>

        <a href="/content" class:list={['nav-item', { active: navActive.content }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          <span class="nav-label">{t('layout.nav.content')}</span>
        </a>

        <a href="/media" class:list={['nav-item', { active: navActive.media }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <span class="nav-label">{t('layout.nav.media')}</span>
        </a>

        <a href="/users" class:list={['nav-item', { active: navActive.users }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          <span class="nav-label">{t('layout.nav.users')}</span>
        </a>

        <a href="/settings" class:list={['nav-item', { active: navActive.settings }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06-.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1.82-.33l-.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0-2.83l-.06-.06a1.65 1.65 0 0 0-.33-1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          <span class="nav-label">{t('layout.nav.settings')}</span>
        </a>

        <!-- Submenu de configurações fica agrupado diretamente sob Settings. -->
        <div class="nav-submenu">
          {settingsChildren.map((child) => (
            <a href={child.href} class:list={['nav-subitem', { active: child.active }]}>
              {child.label}
            </a>
          ))}
        </div>

        <a href="/plugins" class:list={['nav-item', { active: navActive.plugins }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="2" ry="2"></rect>
            <path d="M15 7h4a2 2 0 0 1 2 2v4"></path>
            <path d="M9 17H5a2 2 0 0 1-2-2V9"></path>
            <line x1="8" y1="12" x2="16" y2="12"></line>
          </svg>
          <span class="nav-label">{t('layout.nav.plugins')}</span>
        </a>

        <a href="/themes" class:list={['nav-item', { active: navActive.themes }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            <path d="M2 12h20"></path>
          </svg>
          <span class="nav-label">{t('layout.nav.themes')}</span>
        </a>

        <!-- D1: slots de extensao — paginas de menu declaradas por plugins ativos -->
        <PluginExtensionsSlot client:load />
      </nav>
    </aside>

    <main class="main-content">
      <div class="content-wrapper">
        <div class="content">
          <slot />
        </div>

        <!-- Dashboard Widgets (only on dashboard page) -->
        {pathname === '/' && (
          <div class="dashboard-widgets-area">
            <div class="dashboard-widgets-grid">
              <AtGlanceWidget client:load />
              <QuickDraftWidget client:load />
              <ActivityWidget client:load />
            </div>
          </div>
        )}

        <!-- Footer -->
        <Footer client:load />
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  import { apiClient } from '../lib/api';

  // Guarda de sessao: verifica /me com cookies HttpOnly (sem localStorage -
  // o token vive em cookie HttpOnly inacessivel ao JS)
  void (async () => {
    if (!(await apiClient.isLoggedIn())) {
      window.location.replace('/login');
    }
  })();

  // Estado salvo da sidebar colapsada (o botao de toggle fica no AdminBar e
  // alterna body.sidebar-collapsed + persiste em localStorage)
  try {
    if (localStorage.getItem('sidebar-collapsed') === 'true') {
      document.body.classList.add('sidebar-collapsed');
    }
  } catch {
    // storage indisponivel - sidebar inicia expandida
  }

</script>

<style>
  /* Layout with admin bar offset */
  .layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    min-height: 100vh;
    padding-top: 46px; /* admin bar height */
  }

  /* Collapsed sidebar state */
  body.sidebar-collapsed .layout {
    grid-template-columns: 72px 1fr;
  }

  body.sidebar-collapsed .sidebar-nav .nav-item span,
  body.sidebar-collapsed .nav-submenu {
    display: none;
  }

  body.sidebar-collapsed .sidebar {
    width: 72px;
    padding: 1rem 0.5rem;
  }

  body.sidebar-collapsed .nav-item {
    justify-content: center;
    padding: 0.5rem;
  }

  body.sidebar-collapsed .sidebar-toggle {
    margin: 0 auto;
  }

  body.sidebar-collapsed .sidebar-collapsed-brand {
    display: block !important;
    text-align: center;
    padding: 0.5rem;
  }

  body.sidebar-collapsed .main-content {
    margin-left: 0;
  }

  /* Collapsed brand in sidebar header */
  .sidebar-collapsed-brand {
    display: none;
    text-align: center;
    padding: 0.5rem;
  }

  /* Sidebar */
  .sidebar {
    background: var(--color-surface-dark);
    border-right: 1px solid var(--color-border);
    padding: 1.5rem 1rem;
    height: calc(100vh - 46px);
    position: sticky;
    top: 46px;
    overflow-y: auto;
    transition: width 0.2s ease, padding 0.2s ease;
    width: 260px;
    z-index: 100;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }


  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    color: rgba(255,255,255,0.7);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .nav-item:hover {
    background: rgba(255,255,255,0.1);
    color: #fff;
  }

  .nav-item.active {
    background: var(--color-primary);
    color: var(--color-ink);
  }

  .nav-item svg { flex-shrink: 0; width: 20px; height: 20px; }

  .nav-submenu {
    margin: 0.25rem 0 0.5rem 1.5rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--color-primary);
  }

  .nav-subitem {
    display: block;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-sm);
    color: rgba(255,255,255,0.6);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .nav-subitem:hover {
    background: rgba(255,255,255,0.1);
    color: #fff;
  }

  .nav-subitem.active {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Content Wrapper */
  .content-wrapper {
    padding: 1.5rem;
    background: var(--color-background);
    min-height: calc(100vh - 46px - 48px); /* admin bar + footer */
  }

  .content { max-width: 1200px; margin: 0 auto; }

  /* Dashboard Widgets Area */
  .dashboard-widgets-area {
    margin-bottom: 2rem;
  }

  .dashboard-widgets-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 1200px) {
    .dashboard-widgets-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .dashboard-widgets-grid { grid-template-columns: 1fr; }
  }

  /* Footer */
  .admin-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 48px;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: 0 1.5rem;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    gap: 1.5rem;
  }

  .footer-left { display: flex; flex-direction: column; gap: 0.125rem; }

  .footer-version {
    display: flex; align-items: center; gap: 0.5rem;
    font-weight: 600; color: var(--color-text); font-size: 0.8125rem;
  }

  .version-badge {
    background: var(--color-primary-soft);
    color: var(--color-primary);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    font-size: 0.6875rem;
    font-weight: 700;
  }


  .footer-links {
    display: flex; gap: 1.5rem;
  }

  .footer-links a {
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-links a:hover { color: var(--color-primary); }

  .footer-right { text-align: right; }
  .footer-powered { font-size: 0.6875rem; color: var(--color-muted); }

  @media (max-width: 768px) {
    .admin-footer { flex-direction: column; height: auto; padding: 0.75rem 1rem; gap: 0.5rem; }
    .footer-content { flex-direction: column; gap: 0.5rem; }
    .footer-links { flex-wrap: wrap; justify-content: center; }
  }

  /* RTL adjustments */
  [dir="rtl"] .layout { grid-template-columns: 1fr 260px; }
  [dir="rtl"] body.sidebar-collapsed .layout { grid-template-columns: 1fr 72px; }
  [dir="rtl"] .sidebar { border-right: none; border-left: 1px solid var(--color-border); }
  [dir="rtl"] body.sidebar-collapsed .sidebar { border-left: none; }
  [dir="rtl"] .nav-submenu { border-left: none; border-right: 1px solid var(--color-border); margin-left: 0; margin-right: 1.5rem; padding-left: 0; padding-right: 0.75rem; }
</style>

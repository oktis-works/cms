---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const pathname = Astro.url.pathname;
const isActive = (href: string): boolean =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);

const navActive = {
  dashboard: isActive('/'),
  content: isActive('/content'),
  media: isActive('/media'),
  users: isActive('/users'),
  settings: isActive('/settings'),
};

const settingsChildren = [
  { href: '/settings/general', label: 'General', active: isActive('/settings/general') },
  { href: '/settings/post-types', label: 'Content Types', active: isActive('/settings/post-types') },
  { href: '/settings/taxonomies', label: 'Taxonomies', active: isActive('/settings/taxonomies') },
];
---

<BaseLayout title={title} description={description}>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <h2 class="text-lg font-bold">OkCMS</h2>
        <span class="badge badge-secondary">Admin</span>
      </div>

      <nav class="sidebar-nav">
        <a href="/" class:list={['nav-item', { active: navActive.dashboard }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          Dashboard
        </a>

        <a href="/content" class:list={['nav-item', { active: navActive.content }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          Content
        </a>

        <a href="/media" class:list={['nav-item', { active: navActive.media }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          Media
        </a>

        <a href="/users" class:list={['nav-item', { active: navActive.users }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          Users
        </a>

        <a href="/settings" class:list={['nav-item', { active: navActive.settings }]}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          Settings
        </a>

        <div class="nav-submenu">
          {settingsChildren.map((child) => (
            <a href={child.href} class:list={['nav-subitem', { active: child.active }]}>
              {child.label}
            </a>
          ))}
        </div>
      </nav>
    </aside>

    <main class="main-content">
      <header class="main-header">
        <h1 class="text-lg font-bold">{title}</h1>
        <div class="header-actions">
          <button class="btn btn-secondary btn-sm" id="logout-btn">Logout</button>
        </div>
      </header>

      <div class="content">
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  import { apiClient } from '../lib/api';

  // Guarda de sessão: sem token → volta para o login (o token vive no localStorage)
  if (!apiClient.isLoggedIn()) {
    window.location.replace('/login');
  }

  // Logout: encerra a sessão no backend (best-effort) e limpa o token local
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    try {
      await apiClient.logout();
    } catch {
      // sem rede/sessão expirada — seguimos para o login mesmo assim
    }
    apiClient.clearTokens();
    window.location.href = '/login';
  });
</script>

<style>
  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-submenu {
    display: flex;
    flex-direction: column;
    margin: 0.15rem 0 0.4rem 1.75rem;
    gap: 0.1rem;
    border-left: 1px solid var(--color-border);
    padding-left: 0.6rem;
  }

  .nav-subitem {
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .nav-subitem:hover {
    color: var(--color-text);
    background: var(--color-bg-tertiary);
  }

  .nav-subitem.active {
    color: var(--color-primary);
    font-weight: 600;
  }

  .main-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .content {
    max-width: 1200px;
  }
</style>

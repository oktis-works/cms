  "helpTabs": {
    "title": "Msaada",
    "label": "Msaada",
    "tabs": "Mada za msaada",
    "topics": {
      "overview": {
        "label": "Kwa mtazamo",
        "content": "<h4>Karibu kwenye Dashibodi ya OkCMS</h4><p>Dashibodi hii inakupa mwujuzi wa maudhui na shughuli za tovuti yako.</p><h4>Vifaa vinavyopatikana</h4><ul><li><strong>Kwa mtazamo:</strong> muhtasari wa machapisho, kurasa, midia na watumiaji</li><li><strong>Rasimu ya haraka:</strong> hifadhi rasimu kwa haraka kutoka dashibodi</li><li><strong>Shughuli:</strong> shughuli na masasisho ya hivi karibuni ya tovuti</li></ul>"
      },
      "content": {
        "label": "Usimamizi wa maudhui",
        "content": "<h4>Kusimamiza maudhui</h4><p>Tengeneza, hariri na chapisha maudhui kutoka sehemu ya Maudhui.</p><h4>Vitendo vya haraka</h4><ul><li>Bonyeza \"Maudhui mapya\" kutengeneza wigo kipya au ukurasa</li><li>Tumia vichujio kupata maudhui mahususi</li><li>Vitendo vya pamoja vinapatikana kwa vipengee vyengi</li></ul>"
      },
      "media": {
        "label": "Maktaba ya media",
        "content": "<h4>Kusimamiza midia</h4><p>Pakia na simamia picha, video na nyaraka.</p><h4>Vidokezo</h4><ul><li>Vuta na tone faili ili kupakia</li><li>Ongeza maandishi mbadala kwa ufikivu</li><li>Panga kwa folda (inakuja hivi karibuni)</li></ul>"
      }
    }
  },

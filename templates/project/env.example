# OkCMS - Environment
# Copie para .env e ajuste os valores.

# Application
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=okcms
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/okcms

# Redis (cache + filas do worker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.data/storage
STORAGE_PUBLIC_BASE=/storage

# S3 (quando STORAGE_DRIVER=s3)
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Multi-tenant
DEFAULT_TENANT=default

# Theme
ACTIVE_THEME=

# Ports dos apps auxiliares
ADMIN_PORT=3001
WEB_PORT=3002
